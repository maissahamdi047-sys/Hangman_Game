
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="Hangman.HangmanController"
            prefHeight="600.0" prefWidth="810.0"
            stylesheets="@Style.css"
            fx:id="mainBorderPane">

    <top>
        <VBox alignment="CENTER" spacing="20">
            <padding>
                <Insets top="10" bottom="20" />
            </padding>
            <Label  text="Hangman Game" styleClass="title-label"/>
        </VBox>
    </top>

    <center>
        <HBox spacing="20" alignment="CENTER">
            <ImageView fx:id="hangmanImage" fitWidth="300" fitHeight="300" preserveRatio="true" />

            <VBox spacing="20" alignment="CENTER">
                <Label fx:id="wordLabel" styleClass="word-label" />
                <Label fx:id="messageLabel" styleClass="message-label" />

                <HBox spacing="10" alignment="CENTER">
                    <TextField fx:id="letterInput" maxWidth="100" promptText="Letter" />
                    <Button fx:id="submitButton" text="New Try" />
                    <Button fx:id="newGameButton" text=" New Game" />
                </HBox>
            </VBox>
        </HBox>

    </center>

    <bottom>
        <VBox alignment="CENTER" spacing="10">
            <padding>
                <Insets bottom="200" />
            </padding>
            <Label text="Used Letters:" />
            <FlowPane fx:id="lettersPane" alignment="CENTER" hgap="10" vgap="10" />
        </VBox>
    </bottom>

</BorderPane>